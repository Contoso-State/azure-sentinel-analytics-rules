// Rule: Shadow AI Desktop Application Detection
// Description: Detects AI desktop applications (ChatGPT.exe, Claude.exe) communicating
//              with AI API endpoints via DeviceNetworkEvents process correlation.
// MITRE ATT&CK: T1219 (Remote Access Software), T1567 (Exfiltration Over Web Service)
// Severity: High | Frequency: PT15M | Period: PT1H

let timeWindow = 1h;
let usageThreshold = 3;
let aiDesktopProcesses = dynamic(["ChatGPT.exe", "Claude.exe"]);
let aiAPIDomains = dynamic([
    "api.openai.com", "chat.openai.com", "chatgpt.com", "cdn.oaistatic.com",
    "api.anthropic.com", "claude.ai", "api.claude.ai"
]);
let excludedUsers = dynamic([]);
DeviceNetworkEvents
| where TimeGenerated > ago(timeWindow)
| where ActionType == "ConnectionSuccess"
| where InitiatingProcessFileName in~ (aiDesktopProcesses)
| where RemoteUrl has_any (aiAPIDomains)
    or RemoteUrl has "openai.com"
    or RemoteUrl has "anthropic.com"
    or RemoteUrl has "claude.ai"
| where InitiatingProcessAccountUpn !in~ (excludedUsers)
| where InitiatingProcessAccountUpn != ""
| extend AIApplication = case(
    InitiatingProcessFileName =~ "ChatGPT.exe", "ChatGPT Desktop",
    InitiatingProcessFileName =~ "Claude.exe", "Claude Desktop",
    "Unknown AI Desktop App"
)
| summarize
    ConnectionCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    TotalSentBytes = sum(tolong(column_ifexists("SentBytes", 0))),
    TotalReceivedBytes = sum(tolong(column_ifexists("ReceivedBytes", 0))),
    DistinctDomains = make_set(RemoteUrl, 10),
    DistinctPorts = make_set(RemotePort, 5),
    ProcessPaths = make_set(column_ifexists("InitiatingProcessFolderPath", ""), 3),
    SHA256Hashes = make_set(column_ifexists("InitiatingProcessSHA256", ""), 3)
  by
    InitiatingProcessAccountUpn,
    DeviceName,
    AIApplication,
    InitiatingProcessFileName,
    bin(TimeGenerated, 1h)
| where ConnectionCount >= usageThreshold
| extend
    DataSentMB = round(todouble(TotalSentBytes) / 1048576, 2),
    DataReceivedMB = round(todouble(TotalReceivedBytes) / 1048576, 2)
| extend
    AccountName = InitiatingProcessAccountUpn,
    HostName = DeviceName,
    ProcessName = InitiatingProcessFileName
| project
    TimeGenerated,
    AccountName,
    HostName,
    AIApplication,
    ProcessName,
    ConnectionCount,
    DataSentMB,
    DataReceivedMB,
    FirstSeen,
    LastSeen,
    DistinctDomains,
    DistinctPorts,
    ProcessPaths,
    SHA256Hashes
| order by DataSentMB desc
