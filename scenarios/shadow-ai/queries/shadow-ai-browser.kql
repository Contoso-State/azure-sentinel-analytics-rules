// Rule: Shadow AI Browser Usage Detection
// Description: Detects browser-based connections to unauthorized AI applications
//              from managed endpoints via DeviceNetworkEvents.
// MITRE ATT&CK: T1567 (Exfiltration Over Web Service)
// Severity: Medium | Frequency: PT15M | Period: PT1H

let timeWindow = 1h;
let usageThreshold = 3;
let domainSuffix = "contoso.com";
let excludedUsers = dynamic([]);
let shadowAIDomains = dynamic([
    "chat.openai.com", "chatgpt.com", "api.openai.com", "cdn.oaistatic.com",
    "claude.ai", "api.anthropic.com",
    "gemini.google.com", "bard.google.com", "generativelanguage.googleapis.com",
    "copilot.microsoft.com", "sydney.bing.com", "edgeservices.bing.com",
    "chat.deepseek.com", "api.deepseek.com",
    "perplexity.ai", "www.perplexity.ai",
    "grok.com", "x.ai",
    "poe.com", "www.poe.com"
]);
DeviceNetworkEvents
| where TimeGenerated > ago(timeWindow)
| where ActionType == "ConnectionSuccess"
| where RemoteUrl has_any (shadowAIDomains)
    or RemoteUrl has "openai.com"
    or RemoteUrl has "anthropic.com"
    or RemoteUrl has "gemini.google"
    or RemoteUrl has "copilot.microsoft"
    or RemoteUrl has "deepseek.com"
    or RemoteUrl has "perplexity.ai"
    or RemoteUrl has "grok.com"
    or RemoteUrl has "poe.com"
| extend ResolvedUpn = case(
    InitiatingProcessAccountUpn != "",
        InitiatingProcessAccountUpn,
    InitiatingProcessAccountName !in ("", "system", "local service", "network service"),
        strcat(InitiatingProcessAccountName, "@", domainSuffix),
    ""
)
| where ResolvedUpn !in~ (excludedUsers)
| where ResolvedUpn != ""
| extend ShadowAIApp = case(
    RemoteUrl has "openai" or RemoteUrl has "chatgpt", "ChatGPT",
    RemoteUrl has "claude" or RemoteUrl has "anthropic", "Claude",
    RemoteUrl has "gemini" or RemoteUrl has "bard" or RemoteUrl has "generativelanguage.googleapis", "Google Gemini",
    RemoteUrl has "copilot.microsoft" or RemoteUrl has "sydney.bing" or RemoteUrl has "edgeservices.bing", "Microsoft Copilot",
    RemoteUrl has "deepseek", "DeepSeek",
    RemoteUrl has "perplexity", "Perplexity",
    RemoteUrl has "grok" or RemoteUrl has "x.ai", "Grok",
    RemoteUrl has "poe.com", "Poe",
    "Unknown AI App"
)
| summarize
    ConnectionCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    DomainsAccessed = make_set(RemoteUrl, 10),
    DistinctPorts = make_set(RemotePort, 5)
  by
    ResolvedUpn,
    DeviceName,
    ShadowAIApp
| where ConnectionCount >= usageThreshold
| extend
    AccountName = ResolvedUpn,
    HostName = DeviceName,
    TimeGenerated = FirstSeen
| project
    TimeGenerated,
    AccountName,
    HostName,
    ShadowAIApp,
    ConnectionCount,
    FirstSeen,
    LastSeen,
    DomainsAccessed,
    DistinctPorts
| order by ConnectionCount desc
