// Rule: Shadow AI Usage with Session Attribution
// Description: Detects Shadow AI usage with reliable per-user attribution via
//              DeviceInfo.LoggedOnUsers join. Solves the SYSTEM-context gap where
//              InitiatingProcessAccountUpn is empty for background processes.
// MITRE ATT&CK: T1567 (Exfiltration Over Web Service)
// Severity: Medium | Frequency: PT15M | Period: PT1H

let domainSuffix = "contoso.com";
let excludedUsers = dynamic([]);
let upnLookup = SigninLogs
    | where TimeGenerated > ago(14d)
    | summarize arg_max(TimeGenerated, UserPrincipalName) by UserId
    | extend SAMKey = tolower(replace_string(tostring(split(UserPrincipalName, "@")[0]), ".", ""))
    | project SAMKey, RealUPN = UserPrincipalName;
let timeWindow = 1h;
let usageThreshold = 1;
let shadowAIDomains = dynamic([
    "openai.com", "chatgpt.com", "chat.openai.com",
    "anthropic.com", "claude.ai",
    "gemini.google.com", "generativelanguage.googleapis.com",
    "copilot.microsoft.com",
    "deepseek.com", "chat.deepseek.com",
    "perplexity.ai",
    "grok.com", "x.ai",
    "poe.com"
]);
DeviceNetworkEvents
| where TimeGenerated > ago(timeWindow)
| where ActionType == "ConnectionSuccess"
| where RemoteUrl has_any (shadowAIDomains)
| join kind=leftouter (
    DeviceInfo
    | where TimeGenerated > ago(timeWindow)
    | mv-expand todynamic(LoggedOnUsers)
    | extend LoggedOnUser = tostring(LoggedOnUsers.UserName)
    | where LoggedOnUser != ""
    | summarize arg_max(TimeGenerated, LoggedOnUser) by DeviceName
) on DeviceName
| where LoggedOnUser !in ("", "system", "local service", "network service")
| extend SAMKey = tolower(LoggedOnUser)
| lookup upnLookup on SAMKey
| extend ResolvedUpn = coalesce(RealUPN, strcat(LoggedOnUser, "@", domainSuffix))
| where ResolvedUpn !in~ (excludedUsers)
| where ResolvedUpn != ""
| extend ShadowAIApp = case(
    RemoteUrl has "openai" or RemoteUrl has "chatgpt",          "ChatGPT",
    RemoteUrl has "claude" or RemoteUrl has "anthropic",        "Claude",
    RemoteUrl has "gemini" or RemoteUrl has "generativelanguage","Google Gemini",
    RemoteUrl has "copilot.microsoft",                          "Microsoft Copilot",
    RemoteUrl has "deepseek",                                   "DeepSeek",
    RemoteUrl has "perplexity",                                 "Perplexity",
    RemoteUrl has "grok" or RemoteUrl has "x.ai",              "Grok",
    RemoteUrl has "poe.com",                                    "Poe",
    "Unknown AI App"
)
| summarize
    ConnectionCount   = count(),
    FirstSeen         = min(TimeGenerated),
    LastSeen          = max(TimeGenerated),
    DistinctUrls      = make_set(RemoteUrl, 10),
    DistinctIPs       = make_set(RemoteIP, 10),
    DistinctProcesses = make_set(InitiatingProcessFileName, 5)
  by
    ResolvedUpn,
    LoggedOnUser,
    DeviceName,
    ShadowAIApp
| where ConnectionCount >= usageThreshold
| extend
    LoggedOnUserName = tostring(split(ResolvedUpn, "@")[0]),
    UPNSuffix        = tostring(split(ResolvedUpn, "@")[1]),
    AccountName      = ResolvedUpn,
    HostName         = DeviceName,
    TimeGenerated    = FirstSeen
| project
    TimeGenerated,
    AccountName,
    LoggedOnUserName,
    UPNSuffix,
    HostName,
    LoggedOnUser,
    ShadowAIApp,
    ConnectionCount,
    FirstSeen,
    LastSeen,
    DistinctUrls,
    DistinctIPs,
    DistinctProcesses
| order by ConnectionCount desc
