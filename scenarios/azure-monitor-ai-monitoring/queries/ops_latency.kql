// =============================================================================
// Latency by Model
// =============================================================================
// File:    ops_latency.kql
// Purpose: Per-model latency (avg, p50, p95) in 15-minute buckets, derived from the DurationMs field on RequestResponse rows.
// Sources: AzureDiagnostics (Category=RequestResponse)
// Output:  TimeGenerated, ModelDeployment, AvgMs, P50Ms, P95Ms
// Params:  {TimeRange}, {ModelFilter}
//
// Note: workbook tokens like {TimeRange}, {ModelFilter} and {SelectedKPI} are
// substituted by Azure Monitor Workbooks at run time. To run a file directly
// in the Log Analytics blade, replace {TimeRange} with e.g. > ago(24h) and
// any string tokens (e.g. {SelectedKPI}) with a quoted literal.
// =============================================================================

AzureDiagnostics
| where TimeGenerated {TimeRange}
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES"
| where Category == "RequestResponse"
| extend p = parse_json(properties_s)
| extend ModelDeployment = tostring(p.modelDeploymentName)
| where ModelDeployment != ""
| where "{ModelFilter}" == "*" or ModelDeployment =~ "{ModelFilter}"
| summarize
    AvgMs = avg(todouble(DurationMs)),
    P50Ms = percentile(todouble(DurationMs), 50),
    P95Ms = percentile(todouble(DurationMs), 95)
    by bin(TimeGenerated, 15m), ModelDeployment
| order by TimeGenerated asc
