// =============================================================================
// Safety Metrics by Model
// =============================================================================
// File:    safety_by_model.kql
// Purpose: Per-model breakdown of HTTP status outcomes: 2xx success, 400 (often content-filter), 401/403 auth, 429 throttle, 5xx server. Derived from RequestResponse status codes.
// Sources: AzureDiagnostics (Category=RequestResponse)
// Output:  ModelDeployment, Success, ContentFilter400, Auth401_403, Throttles429, Server5xx, Total
// Params:  {TimeRange}
//
// Note: workbook tokens like {TimeRange}, {ModelFilter} and {SelectedKPI} are
// substituted by Azure Monitor Workbooks at run time. To run a file directly
// in the Log Analytics blade, replace {TimeRange} with e.g. > ago(24h) and
// any string tokens (e.g. {SelectedKPI}) with a quoted literal.
// =============================================================================

AzureDiagnostics
| where TimeGenerated {TimeRange}
| where ResourceProvider == "MICROSOFT.COGNITIVESERVICES"
| where Category == "RequestResponse"
| extend p = parse_json(properties_s)
| extend ModelDeployment = tostring(p.modelDeploymentName)
| extend StatusCode      = toint(ResultSignature)
| where ModelDeployment != ""
| summarize
    Success = countif(StatusCode between (200 .. 299)),
    ContentFilter400 = countif(StatusCode == 400),
    Auth401_403 = countif(StatusCode in (401, 403)),
    Throttles429 = countif(StatusCode == 429),
    Server5xx = countif(StatusCode >= 500),
    Total = count()
    by ModelDeployment
| order by Total desc
